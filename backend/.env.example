# ==========================================================
# CONFIGURAÇÕES DE PRODUÇÃO - BACKEND (NESTJS)
# ==========================================================

PORT=3005
NODE_ENV=production

# Chave secreta para assinatura de tokens JWT (gere no terminal com: openssl rand -base64 32)
JWT_SECRET="gere-sua-chave-com-openssl-rand-base64-32"

# Credenciais de acesso inicial ao painel /admin (utilizadas no seed)
ADMIN_EMAIL=seu-email@dominio.com
ADMIN_PASSWORD=SuaSenhaForteAqui@2026

# Banco de Dados SQLite (arquivo local dev.db em backend/)
DATABASE_URL="file:./dev.db"

# Domínio do Frontend permitido no CORS (ajuste para o subdomínio da sua VPS)
CORS_ORIGIN=https://portifolio.vps6663.panel.icontainer.run,http://localhost:3000
